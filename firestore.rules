rules_version = '2';

// Sotto — Firestore security rules (deploy with `firebase deploy --only firestore:rules`).
// Owner-scoped entries: every document carries ownerUid (written by the sync
// layer from the authenticated anonymous uid); users can only read and write
// their own documents. Private entries are never synced at all (structural
// exclusion in src/firebase/sync.ts) — these rules are the second line of defense.
service cloud.firestore {
  match /databases/{database}/documents {
    match /entries/{entryId} {
      allow read, update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
    }
  }
}
